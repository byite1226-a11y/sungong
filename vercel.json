{
  "headers": [
    { "source": "/wasm/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "headers": [
      { "key": "Permissions-Policy", "value": "camera=(self)" },
      { "key": "Referrer-Policy", "value": "no-referrer" }
    ]}
  ]
}
